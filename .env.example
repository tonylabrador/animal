# Public site URL used in confirmation and animal links
NEXT_PUBLIC_SITE_URL=https://animal.prismbase.org

# Resend: API key, verified sender, and the subscriber Segment ID
RESEND_API_KEY=
RESEND_FROM_EMAIL="Wild Explorer <updates@animal.prismbase.org>"
RESEND_SEGMENT_ID=

# Generate both secrets independently with: openssl rand -hex 32
SUBSCRIBE_SIGNING_SECRET=
NEWSLETTER_SEND_SECRET=

# Optional local override for the protected manual-send endpoint
# NEWSLETTER_SEND_URL=http://localhost:3000
