    "life_cycle_and_reproduction": {
      "en": "The female selects the nest site and builds a cup, usually in a depression, among exposed roots, or beneath cover on the ground, though some nests are placed on structures or low branches. A clutch contains 3–6 eggs. Incubation lasts 12–13 days and young remain in the nest for about 10–13 days; a pair may raise 1–3 broods in a season.",
      "zh": "雌鸟选择巢址并筑成杯状巢，通常位于地面凹处、外露树根间或遮蔽物下，也有少数巢设在建筑物或低枝上。每窝产3至6枚卵，孵化期12至13天，雏鸟在巢内约停留10至13天；一对成鸟一季可繁殖1至3窝。",
      "source_keys": [
        "life_history"
      ]
    },
    "adaptations": [
      {
        "title": {
          "en": "White tail flash",
          "zh": "白尾闪现"
        },
        "detail": {
          "en": "White outer tail feathers become conspicuous when the bird spreads its tail or flies, providing a durable field mark across its many plumage forms.",
          "zh": "展开尾羽或飞行时，白色外侧尾羽十分醒目；即使不同地域类型羽色多变，这仍是稳定的野外识别特征。"
        },
        "source_keys": [
          "identification"
        ]
      },
      {
        "title": {
          "en": "Ground-foraging build",
          "zh": "地面觅食体态"
        },
        "detail": {
          "en": "A compact body, short stout bill and hopping, scratching behavior suit a bird that collects fallen seeds and small invertebrates from litter and low vegetation.",
          "zh": "紧凑的体形、短粗的喙以及跳跃刨抓的行为，适合从落叶层和低矮植被中取食落下的种子与小型无脊椎动物。"
        },
        "source_keys": [
          "identification",
          "life_history"
        ]
      },
      {
        "title": {
          "en": "Flexible seasonal movement",
          "zh": "灵活的季节迁移"
        },
        "detail": {
          "en": "Populations use different strategies: many northern birds migrate south, some mountain birds move downhill, and other populations remain near breeding areas year-round.",
          "zh": "不同种群采取不同策略：许多北方个体向南迁徙，一些山地个体冬季下移，另一些种群则全年留在繁殖地附近。"
        },
        "source_keys": [
          "range"
        ]
      },
      {
        "title": {
          "en": "Regional plumage variation",
          "zh": "地域羽色变化"
        },
        "detail": {
          "en": "Strong geographic variation produces several readily recognizable forms, while the pale bill and white outer tail feathers remain shared clues to species identity.",
          "zh": "显著的地理变异形成多个容易辨认的类型，而浅色喙和白色外侧尾羽仍是共同的物种识别线索。"
        },
        "source_keys": [
          "identification"
        ]
      }
    ],
    "ecological_role": {
      "en": "Dark-eyed Juncos are abundant consumers of grass and weed seeds and seasonal predators of insects. They also form part of forest and edge food webs as prey for raptors and other predators. Their winter use of open ground connects forest birds with gardens, parks and agricultural edges.",
      "zh": "暗眼灯草鹀大量取食草本和杂草种子，并在特定季节捕食昆虫；同时也会成为猛禽及其他捕食者的猎物，是森林和林缘食物网的一环。它们冬季利用开阔地面，使森林鸟类与花园、公园和农田边缘生态环境发生联系。",
      "source_keys": [
        "life_history"
      ]
    },
    "conservation_and_threats": {
      "population_trend": "decreasing",
      "threats": {
        "en": "Although globally listed as Least Concern and still abundant, long-term North American monitoring and recent eBird models show a range-wide decline. Loss or alteration of breeding forest and changes to winter habitat can affect local populations.",
        "zh": "本种全球等级为无危且仍很常见，但北美长期监测和近期eBird模型均显示其全分布范围呈下降趋势。繁殖森林的丧失或改变，以及越冬栖息地变化，都可能影响局部种群。"
      },
      "actions": {
        "en": "Continue broad-scale population monitoring, protect diverse breeding forests and understory, and maintain winter ground cover and low-risk urban habitat. Keeping cats indoors and reducing window collisions also benefits small songbirds.",
        "zh": "持续开展大范围种群监测，保护多样的繁殖森林及林下层，并维持越冬地的地面覆盖和低风险城市栖息地。将家猫留在室内并减少鸟撞玻璃，也有助于保护小型鸣禽。"
      },
      "source_keys": [
        "conservation",
        "trend",
        "life_history"
      ]
    },
    "identification": {
      "key_features": {
        "en": "A medium-small sparrow with a rounded head, pale pinkish bill, fairly long tail and white outer tail feathers. Plumage may be gray, brown-backed, hooded, pink-sided or red-backed depending on region and sex.",
        "zh": "中小型雀鸟，头圆、喙呈浅粉色、尾巴较长，外侧尾羽白色。羽色会随地域和性别呈灰色、棕背、深色头罩、粉褐色体侧或红棕背等变化。"
      },
      "similar_species": {
        "en": "Yellow-eyed Junco has conspicuously yellow eyes and a more restricted Mexican and southeastern Arizona range. Spotted Towhee is larger, has a heavier bill and typically shows rufous sides; juvenile Dark-eyed Juncos can be streaky but retain the overall small-billed shape and white outer tail feathers.",
        "zh": "黄眼灯草鹀具有醒目的黄色眼睛，主要局限于墨西哥和亚利桑那州东南部；斑唧鹀体形更大、喙更粗重，通常有棕红色体侧。暗眼灯草鹀幼鸟虽有纵纹，但仍保留小喙体态和白色外侧尾羽。"
      },
      "source_keys": [
        "identification"
      ]
    },
    "communication_and_senses": {
      "en": "The male's simple song is an even musical trill lasting about two seconds. Birds also give high, thin chip notes while foraging or when alert, and excited calls accompany territorial chases. Vision and hearing guide ground foraging and flock coordination.",
      "zh": "雄鸟的鸣唱是持续约两秒、节奏均匀的音乐性颤音。觅食或警戒时会发出高而细的“chip”叫声，保卫领地追逐时叫声更急促。视觉和听觉帮助它们在地面觅食并协调群体行动。",
      "source_keys": [
        "identification",
        "life_history"
      ]
    },
    "seasonal_calendar": {
      "en": "Spring and summer are the main territorial and nesting period in northern and mountain forests. In autumn many birds move south or to lower elevations. Winter flocks occupy open woodland, fields, roadsides, parks and backyards, before migrants return north or uphill in spring.",
      "zh": "春夏是北方和山地森林中主要的占区与筑巢期。秋季许多个体向南或向低海拔迁移；冬季鸟群活动于疏林、田野、路边、公园和庭院，翌春再向北或向高海拔返回。",
      "source_keys": [
        "range",
        "life_history"
      ]
    },
    "relationship_with_humans": {
      "en": "Juncos readily feed on millet and other seeds scattered on or beneath feeders, making them familiar winter visitors in many North American neighborhoods. Their winter arrival inspired the nickname “snowbird.” People can help by offering clean ground-feeding areas and reducing common urban bird hazards.",
      "zh": "暗眼灯草鹀常取食撒在地面或喂鸟器下方的小米等种子，因此是北美许多社区熟悉的冬季访客。它们随冬季到来，因而获得“雪鸟”的昵称。人们可通过保持地面取食区清洁并减少常见城市鸟类风险来帮助它们。",
      "source_keys": [
        "general",
        "life_history"
      ]
    },
    "evolution": {
      "en": "The Dark-eyed Junco belongs to the New World sparrow family Passerellidae. About 15 named races show unusually strong geographic variation; 6 forms are readily recognized in the field, and several were treated as separate species until the 1980s. This variation has made the junco an important model for studying rapid diversification.",
      "zh": "暗眼灯草鹀属于美洲雀科。约15个已命名亚种呈现格外显著的地理变异，其中6种类型可在野外较容易辨认；直到1980年代，其中多个类型仍被视为独立物种。这种变异使灯草鹀成为研究快速分化的重要模型。",
      "source_keys": [
        "taxonomy",
        "identification",
        "evolution"
      ]
    },
    "field_signs": {
      "en": "Watch for small flocks hopping beneath shrubs or feeders, scratching leaf litter with quick backward motions. When flushed, the birds make short low flights and flash white outer tail feathers. Thin chip notes and a neat two-second trill often reveal them before their variable plumage does.",
      "zh": "可留意在灌木或喂鸟器下成小群跳跃的个体；它们会迅速向后刨抓落叶。受惊时常作短距离低飞，并闪现白色外侧尾羽。细高的“chip”声和整齐、约两秒的颤音，常比多变的羽色更早暴露它们。",
      "source_keys": [
        "identification",
        "life_history"
      ]
    },
    "did_you_know": [
      {
        "text": {
          "en": "The oldest recorded Dark-eyed Junco was at least 11 years and 4 months old when recaptured and released.",
          "zh": "有记录的最老暗眼灯草鹀在再次捕获并放归时至少已有11岁4个月。"
        },
        "source_keys": [
          "general"
        ]
      },
      {
        "text": {
          "en": "6 regional forms are readily recognizable, even though they are treated as one species.",
          "zh": "尽管都归为同一物种，仍有6种地域类型可在野外较容易辨认。"
        },
        "source_keys": [
          "identification"
        ]
      },
      {
        "text": {
          "en": "White outer tail feathers are present even in streaky juveniles and flash most clearly in flight.",
          "zh": "即使纵纹明显的幼鸟也有白色外侧尾羽，飞行时最为醒目。"
        },
        "source_keys": [
          "identification"
        ]
      },
      {
        "text": {
          "en": "Winter flocks establish dominance hierarchies, and birds that arrive earlier often rank above later arrivals.",
          "zh": "冬季鸟群会形成等级秩序，较早到达的个体往往排在后来者之上。"
        },
        "source_keys": [
          "life_history"
        ]
      }
    ],
    "class_specific": [
      {
        "title": {
          "en": "Nesting strategy",
          "zh": "筑巢策略"
        },
        "content": {
          "en": "Most nests are on or very near the ground, tucked into slopes, roots or cover. The female chooses the site and builds the cup.",
          "zh": "大多数巢位于地面或非常接近地面，藏在坡面、树根或遮蔽物中；由雌鸟选址并筑成杯状巢。"
        },
        "source_keys": [
          "life_history"
        ]
      },
      {
        "title": {
          "en": "Plumage forms",
          "zh": "羽色类型"
        },
        "content": {
          "en": "Slate-colored, Oregon, pink-sided, gray-headed, red-backed and white-winged forms can look strikingly different, so the pale bill and white outer tail are especially useful shared clues.",
          "zh": "石板色型、俄勒冈型、粉肋型、灰头型、红背型和白翅型外观可有显著差异，因此浅色喙与白色外侧尾羽是特别有用的共同线索。"
        },
        "source_keys": [
          "identification"
        ]
      },
      {
        "title": {
          "en": "Seasonal movement",
          "zh": "季节迁移"
        },
        "content": {
          "en": "The species combines long-distance migration, shorter elevational movement and year-round residency, depending on population and location.",
          "zh": "本种会因种群和地点不同，采取长距离迁徙、较短的垂直迁移或全年留居等多种策略。"
        },
        "source_keys": [
          "range"
        ]
      }
    ]
  },
